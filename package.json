{
  "name": "@local/dsh-live-tps",
  "version": "0.7.1",
  "description": "Live token throughput (tok/s) readout for the DSH composer stats row: 3s window estimate while streaming, exact per-step measurement (client-observed, else recomputed from the session log) once a step settles.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/client-smoke.mjs && node test/client-dom-smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
